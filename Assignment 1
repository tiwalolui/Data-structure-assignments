class Stack:
    def __init__(self, max_size=5):
        self.stack = []
        self.max_size = max_size

    def push(self, item):
        if self.isfull():
            print("Stack Overflow! Cannot push item:", item)
            return False
        self.stack.append(item)
        print(f"Pushed: {item}")
        return True

    def pop(self):
        if self.isempty():
            print("Stack Underflow! Cannot pop from an empty stack.")
            return None
        item = self.stack.pop()
        print(f"Popped: {item}")
        return item

    def isempty(self):
        return len(self.stack) == 0

    def isfull(self):
        return len(self.stack) >= self.max_size

    def peek(self):
        if self.isempty():
            print("Stack is empty! Nothing to peek.")
            return None
        return self.stack[-1]

    def size(self):
        return len(self.stack)

s = Stack(max_size=3)
print("Is empty?:", s.isempty())
s.push(10)
s.push(20)
s.push(30)
print("Is full?:", s.isfull())
print("Current size:", s.size())
print("Peek top item:", s.peek())
s.push(40)
s.pop()
print("Peek after one pop:", s.peek())
s.pop()
s.pop()
s.pop()
